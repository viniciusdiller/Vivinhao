//.ENV


# Configuração do Servidor
PORT=

# Configuração da Base de Dados
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Segredo para JWT de usuários comuns
JWT_SECRET=
PROVISION_WEBHOOK_SECRET=

# Login de administrador fixo (não depende de tenant/usuário no banco).
# ADMIN_TENANT_ID é opcional: se vazio, resolve automaticamente o único
# tenant existente.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TENANT_ID=
ADMIN_TENANT_NAME=

# Ambiente
NODE_ENV=

# Sincronizacao automatica de schema (Sequelize sync({ alter: true }))
# Por padrao: true fora de producao, false em producao.
DB_AUTO_SYNC=

# Tenant usado pela rota publica de quartos quando nao ha correspondencia
# explicita (opcional).
PUBLIC_ROOMS_TENANT_ID=

# Segredo servidor-servidor, mínimo 32 caracteres, igual no admin e landing.
# Nunca use NEXT_PUBLIC_ neste segredo.
RESERVATION_API_SECRET=

# Envio de vouchers via Resend: domínio remetente verificado no provedor.
RESEND_API_KEY=
EMAIL_FROM=
# URL HTTPS pública da landing page Viva Mar, usada no link do voucher.
GUEST_PORTAL_URL=
